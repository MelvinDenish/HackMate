# ╔══════════════════════════════════════════════════════════════╗
# ║  HACKATHON AUTOMATION PIPELINE v2 — Environment Variables   ║
# ╚══════════════════════════════════════════════════════════════╝
# Copy this file to .env and fill in your API keys.

# ── Required: Multi-Provider LLM Keys ────────────────────────
ANTHROPIC_API_KEY=sk-ant-...           # Claude Sonnet 4 + Haiku 3.5
GOOGLE_API_KEY=AIza...                 # Gemini 2.5 Flash + Pro
MOONSHOT_API_KEY=sk-moon-...           # Kimi k2 (multimodal)

# ── Required: Platform Keys ──────────────────────────────────
GAMMA_API_KEY=gamma-...                # Gamma.app pitch deck rendering
RAILWAY_API_TOKEN=railway-...          # Railway deployment

# ── Optional: Enhanced Research (Priority 2) ─────────────────
EXA_API_KEY=exa-...                    # Exa AI-native web search
FIRECRAWL_API_KEY=fc-...               # Firecrawl deep page scraping

# ── Optional: Pipeline Configuration ─────────────────────────
PIPELINE_BUDGET_LIMIT=10.00            # Max spend per run in USD (default: $10)
WORKSPACE_ROOT=./workspace             # Shared workspace directory

# ── Optional: Docker Sandbox ─────────────────────────────────
DOCKER_SANDBOX_IMAGE=python:3.12-slim  # Base Docker image for sandbox
DOCKER_SANDBOX_TIMEOUT=120             # Max sandbox execution time (seconds)
